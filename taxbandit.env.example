# Copy to .local/taxbandit.env (gitignored) and fill from
# https://sandbox.taxbandits.com → Settings → API Credentials
# Then: bash scripts/set-taxbandit-secrets.sh

TAXBANDIT_CLIENT_ID=
TAXBANDIT_CLIENT_SECRET=
TAXBANDIT_USER_TOKEN=

# Optional overrides (sandbox defaults used if unset)
# TAXBANDIT_AUTH_URL=https://testoauth.expressauth.net/v2/tbsauth
# TAXBANDIT_API_BASE=https://testapi.taxbandits.com/v1.7.3
EFILE_PROVIDER=TaxBandit
